    <!-- Keep the service alive (Service & Permission Settings screen) -->
    <string name="keep_alive_title">Keep receiving SMS every day</string>
    <string name="keep_alive_intro">A silent foreground service keeps this app in the system\'s active list. Without it, Android downgrades the app to a restricted background state about 24 hours after you last open it, and the phone may freeze it entirely — SMS then silently stops arriving. The service itself sleeps between checks and costs almost no battery.</string>
    <string name="keep_alive_battery_title">Unrestricted battery</string>
    <string name="keep_alive_battery_desc">Prevents the system from throttling or killing the listening service while the screen is off.</string>
    <string name="keep_alive_autostart_title">Autostart</string>
    <string name="keep_alive_autostart_desc">Lets the phone bring the app back after a reboot or a cleanup by the system.</string>
    <string name="keep_alive_autostart_action">Open</string>
    <string name="keep_alive_state_done">Configured</string>
    <string name="keep_alive_state_pending">Action needed</string>
    <string name="keep_alive_footer">A background watchdog (WorkManager) also re-activates the service automatically if it is ever killed.</string>

